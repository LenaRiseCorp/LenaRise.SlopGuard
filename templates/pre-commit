#!/bin/sh
# LenaRise.SlopGuard — scanning at the git level.
#
# Claude Code hooks only cover Claude Code. This hook runs whichever agent wrote
# the code: Cursor, Codex, Copilot, or a human.
#
# It looks for the scanner in three places. If none of them has it the commit is
# NOT blocked, but it does not stay silent either: not everyone on a team can be
# expected to have the plugin installed, and refusing someone's commit because
# their tooling is incomplete would be hostile. The real gate is in CI; this hook
# is an early warning.

set -e

find_scanner() {
  if [ -n "$SLOPGUARD_HOME" ] && [ -f "$SLOPGUARD_HOME/scripts/scan-staged.mjs" ]; then
    echo "$SLOPGUARD_HOME/scripts/scan-staged.mjs"; return 0
  fi
  for dir in "$HOME"/.claude/plugins/cache/*/lenarise-slopguard/*/ \
             "$HOME"/.claude/plugins/cache/*/lenarise-slopguard \
             "$HOME"/.claude/skills/lenarise-slopguard; do
    if [ -f "$dir/scripts/scan-staged.mjs" ]; then echo "$dir/scripts/scan-staged.mjs"; return 0; fi
  done
  return 1
}

if ! command -v node >/dev/null 2>&1; then
  echo "LenaRise.SlopGuard: node not found, this commit was not scanned." >&2
  exit 0
fi

SCANNER=$(find_scanner) || {
  echo "LenaRise.SlopGuard: scanner not found, this commit was not scanned." >&2
  echo "  To install: claude plugin install lenarise-slopguard@lenarise-slopguard" >&2
  echo "  Or point SLOPGUARD_HOME at the plugin directory." >&2
  exit 0
}

exec node "$SCANNER"
